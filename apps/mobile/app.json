{
  "expo": {
    "name": "Métis",
    "slug": "metis-mobile",
    "scheme": "metis",
    "version": "0.2.0",
    "icon": "./assets/icon-light.png",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "icon": {
        "light": "./assets/icon-light.png",
        "dark": "./assets/icon-dark.png"
      },
      "bundleIdentifier": "io.github.hdoria.metis.mobile.dev",
      "infoPlist": {
        "LSSupportsOpeningDocumentsInPlace": true,
        "UIFileSharingEnabled": true
      }
    },
    "android": {
      "package": "io.github.hdoria.metis.mobile.dev"
    },
    "web": {
      "bundler": "metro"
    }
  }
}

# Copy to .env.local and fill in real values.
# These are never committed — .env.local is gitignored.
# If a release workflow needs telemetry, configure its owned destinations:
# - VITE_SENTRY_DSN
# - SENTRY_DSN (the native Rust project's DSN, separate from the React project)
# - VITE_POSTHOG_KEY
# - VITE_POSTHOG_HOST
# Current local desktop setup: docs/sentry-setup.md. CI has no upload credentials.

# Sentry DSN (https://sentry.io → Project → Settings → Client Keys)
VITE_SENTRY_DSN=
SENTRY_DSN=
VITE_SENTRY_RELEASE=
SENTRY_RELEASE=
VITE_SENTRY_ENVIRONMENT=
SENTRY_ENVIRONMENT=

# PostHog (https://posthog.com → Project → Settings → Project API Key)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Lara CLI (https://github.com/translated/lara-cli)
LARA_ACCESS_KEY_ID=
LARA_ACCESS_KEY_SECRET=

# Optional whiteboard: production rendering requires a valid distributor license.
VITE_TLDRAW_LICENSE_KEY=
